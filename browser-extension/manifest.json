{
  "manifest_version": 3,
  "name": "桃子工作台平台数据同步器",
  "version": "0.2.0",
  "description": "从已登录的抖音、小红书创作者后台读取作品统计，并同步到桃子工作台。",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://workbench.taozipipi.cn/*",
    "https://creator.douyin.com/*",
    "https://creator.xiaohongshu.com/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": ["https://workbench.taozipipi.cn/*"],
      "js": ["workbench-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://creator.douyin.com/*", "https://creator.xiaohongshu.com/*"],
      "js": ["platform-collector.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "桃子工作台数据同步" }
}
